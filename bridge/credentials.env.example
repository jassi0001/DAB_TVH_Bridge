# Nach /storage/dab-tvh-bridge/credentials.env kopieren (ohne .example), Rechte: chmod 600
# Umgebungsspezifische Werte der Bridges, nicht im Repo. TVHeadend-Benutzer mit API-Zugriff (Configuration -> Users)
TVH_USER=claude
TVH_PASS=hier-eigenes-passwort
# Eigene LAN-Adresse der Box (Host fuer die Stream-URLs aus rtspd); ohne Angabe: 127.0.0.1
RTSPD_STREAM_HOST=192.168.0.200
